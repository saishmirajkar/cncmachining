# Backend settings (environment variables, prefix CNC_). Copy to backend/.env for local development.
CNC_ENV=development
CNC_DATABASE_URL=postgresql+psycopg://cnc:cnc@localhost:5432/cncplatform
CNC_REDIS_URL=redis://localhost:6379/0
# required in production; must not start with "dev-only"
CNC_SECRET_KEY=dev-only-insecure-secret-change-me
# rq (separate worker process) | thread (single-process dev) | inline (tests)
CNC_QUEUE_BACKEND=thread
CNC_MAX_UPLOAD_MB=100
CNC_GEOMETRY_TIMEOUT_S=180
CNC_CAM_TIMEOUT_S=600
CNC_CAM_MEMORY_LIMIT_MB=4096
# Python interpreter of the FreeCAD environment (see docs/DEPENDENCY_REPORT.md)
CNC_FREECAD_PYTHON=/opt/freecad-env/bin/python
CNC_FREECAD_LIB_DIR=/opt/freecad-env/lib
CNC_SIMULATION_MAX_CELLS=300000
